# story_insert.tbl
# Mapeo caracter -> byte ROM para la insercion.
# Formato: HH=char  (HH = byte que se escribe en la ROM).
# El texto del juego es ASCII mayusculas; la fuente SOLO tiene minusculas a,b,c,d
# (simbolos de boton). Las vocales acentuadas espanolas NO existen en la fuente,
# por lo que se mapean a su version NO acentuada en MAYUSCULAS (misma letra base).
# ?/! no existen -> se mapean a ?/!.
# Los bytes especiales [ \ ] ^ _ < > ' se conservan para round-trip fiel.
