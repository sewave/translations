      "messages": {
        "0": {
          "text_offset": "0x000000",
          "pointer_offset": "0x0000",
          "block_address": "0x0726AB",
          "logical_address": "0xA6AB",
          "bytes": 630,
          "original": "[F9][FB][1D]GOSH,[FB][25] IT [FB][1E]SURE[FF][FB][1D]SEEMS [FB][25][FB][1D]CREEPY[FE]AR[FB][1E]OUND [FB][0A]HERE.[F8][FD][FB][07][FA][FB][25]AN EVIL PHANTOM[FF]HAS STOLEN[FB][08] THE[FE]MAGIC [FB][25]CRYSTAL THAT[F8][FB][25]PROTECTED EVERYONE[FD][FB][07]IN THE VILLAGE.[FF][FB][25]WITH THE CRYSTAL[FE]GONE, THE GOOD[F8][FB][25]MAGIC IN THIS[FD][FB][07][FB][25]VALLEY HAS[FF]DISAPPEARED.[FE]IN [FB][25]ITS PLACE, BAD[F8]MAGIC HAS CHANGED[FD][FB][07]EVERYTHING.[FF][FB][25]NOW, RATHER THAN[FE]BEING A PLACE OF[F8]HAPPIN[FB][25]ESS, THE[FD][FB][07]VALLEY IS FULL OF[FF][FB][25]GLOOM.[FE][FB][09]CAN YOU HELP US?[F8][FD][FB][25][FF][F9][FB][1D]UH, DID [FB][1E]YOU [FB][1D]SAY...[FE]PH[FB][0A]ANTOM?[F8][FD][FB][07][FA][FB][25]YES, AN EVIL[FF]PHANTOM WHO LIVES[FE][FB][25]IN A CASTLE IN THE[F8]CLOUDS![FD][FB][07][FB][08]A GOOD [FB][25]PRINCESS[FF]IN THE NORTH[FE][FB][25]MOUNTAINS CAN TELL[F8]YOU THE BEST WAY[FD][FB][07][FF]TO GET THERE.[FE][F8][FD][FF][F9][FB][0B][FB][0D][FB][0E][FB][1D]SW[FB][26]ELL! I[FB][1E]'LL DO[FB][0A] MY[FE][FB][26]BEST.[F8][FA][FC]"
        },
        "1": {
          "text_offset": "0x000000",
          "pointer_offset": "0x0002",
          "block_address": "0x0728DC",
          "logical_address": "0xA8DC",
          "bytes": 117,
          "original": "[FB][07]A GOOD [FB][25]PRINCESS[FF]IN THE NORTH[FE]MOUNTAINS CAN [FB][25]TELL[F8]YOU HOW TO GET TO[FD][FB][07][FB][25]THE PHANTOM'S[FB][25][FF]CASTLE IN THE[FE][FB][25]CLOUDS.[F8][FC]"
        },
        "2": {
          "text_offset": "0x000000",
          "pointer_offset": "0x0004",
          "block_address": "0x072E63",
          "logical_address": "0xAE63",
          "bytes": 620,
          "original": "[FB][04]IF YOU[FB][25] PLANT THESE[FF]BEANS BENEATH THE[FE][FB][25]PHANTOM'S CLOUD[F8][FB][25]CASTLE, A BEANSTALK[FD][FB][04]WILL[FB][25] GROW INTO THE[FF]CLOUDS, CARRYING[FE]YOU WITH IT. THE[F8][FB][25]CLOUDS HAVE MOVED[FD][FB][04][FB][25]OUT TO SEA, SO YOU[FF]MUST PLANT THE[FE][FB][25]SEEDS ON AN ISLAND[F8]IN THE OCEAN SO[FD][FB][04][FB][25]THAT THE BEANSTALK[FF]WILL GROW IN THE[FE]RIGHT [FB][25]PLACE. THERE[F8]IS A STONE PYRAMID[FD][FB][04]IN [FB][25]THE DESERT.[FF]THERE YOU WILL FIND[FE]THE [FB][25]MAGIC CLOUD[F8]SHOES WHICH WILL[FD][FB][04]HELP[FB][25] YOU WALK ON[FF]CLOUD VAPOR WITHOUT[FE]FALLING[FB][25] THROUGH.[F8]YOU MAY NOT SEE AN[FD][FB][04]ENTRANCE[FB][25] AT FIRST,[FF][FB][25]BUT IF YOU TRY HARD[FE]AND USE YOUR HEAD,[F8]I'M [FB][25]SURE YOU WILL[FD][FB][04][FB][05][FB][25]FIND IT.[FF]IF YOU SUCCEED, I[FE]PROMISE TO [FB][06]REWARD[F8]YOU WITH A KISS.[FC]"
        },
        "3": {
          "text_offset": "0x000000",
          "pointer_offset": "0x0006",
          "block_address": "0x073063",
          "logical_address": "0xB063",
          "bytes": 342,
          "original": "[FB][04]THERE[FB][25] IS A STONE[FF]PYRAMID IN THE[FE]DESERT. [FB][25]THERE YOU[F8]WILL FIND [FB][25]THE MAGIC[FD][FB][04][FB][25]CLOUD SHOES WHICH[FF]WILL HELP YOU WALK[FE][FB][25]ON CLOUD VAPOR[F8]WITHOUT FALLING[FD][FB][04][FB][25]THROUGH.[FF]YOU MAY[FB][25] NOT SEE AN[FE]ENTRANCE AT FIRST,[F8][FB][25]BUT IF YOU TRY HARD[FD][FB][04][FB][25]AND USE YOUR HEAD,[FF][FB][05]I'M[FB][25] SURE YOU WILL[FE]FIND IT. IF YOU[F8]SUCCEED,[FB][25] I PROMISE[FD][FB][04][FB][06]TO REWARD YOU WITH[FF]A KISS.[FE][F8][FC]"
        },
        "4": {
          "text_offset": "0x000000",
          "pointer_offset": "0x0008",
          "block_address": "0x07319C",
          "logical_address": "0xB19C",
          "bytes": 188,
          "original": "[FB][00]THIS[FB][25] FORTRESS[FF]GUARDS[FB][25] THE HARBOR,[FE]BUT THE BAD MAGIC[F8]HAD[FB][25] TURNED IT TO[FD][FB][00]SAND[FB][25]. THANKS FOR[FF]RESCUING ME![FE][FB][01][FB][02][FB][03]LET ME GIVE YOU A[F8]SHIP FROM MY HARBOR[FD][FB][00]TO HELP YOU REACH[FF]THE ISLAND.[FE][F8][FC]"
        },
        "5": {
          "text_offset": "0x000000",
          "pointer_offset": "0x000A",
          "block_address": "0x073253",
          "logical_address": "0xB253",
          "bytes": 78,
          "original": "[FB][00]LET [FB][25]ME GIVE YOU A[FF]SHIP FROM [FB][01][FB][02]MY [FB][03]HARBOR[FE]TO HELP YOU REACH[F8]THE ISLAND.[FC]"
        },
        "6": {
          "text_offset": "0x000000",
          "pointer_offset": "0x000C",
          "block_address": "0x072959",
          "logical_address": "0xA959",
          "bytes": 577,
          "original": "[FB][28]THE BAD [FB][29]MAGIC HAD[FF]ME [FB][28][FB][29]TRAPPED IN MY[FE][FB][28]OWN [FB][29]CASTLE![F8][FD]THANKS [FB][29]FOR SETTIN[FB][28]'[FF]ME FREE.[FB][28][FB][29] YOUR PATH[FE]LIES THROUGH[FB][29] A TINY[F8][FB][28]CAVERN UP AHEAD,[FD][FB][28]BUT,[FB][29] IN ORDER TO[FF][FB][28]ENTER IT[FB][29] YOU HAVE[FE][FB][29]TO SHRINK IN[FB][28] SIZE![F8][FD]THERE[FB][28]'S A SHRINKING[FB][29][FF][FB][28]POTION IN[FB][29] THE[FE]CASTLE[FB][28] RUINS.[F8][FB][29]NOW THAT THE FIRE[FD]IN[FB][29] MY [FB][28]CASTLE HAS[FF]WEAKENED[FB][28], THE WATER[FE]IN[FB][29] THE LAKE[FB][28] HAS[F8]RISEN.[FD]YOU[FB][28] SHOULD BE[FB][29] ABLE[FF]TO [FB][28]FIND A[FB][29] PASSAGE[FE]TO[FB][29] THE RUINS[FB][28] FROM[F8]THE[FB][28] LAKE.[FD][FB][11][FB][12]PLEASE[FB][13][FB][14][FB][16][FB][17] ACCEPT THIS[FB][27][FF]MAGIC[FB][29] FLUTE.[FE]USE [FB][27]IT, AND[FB][29] IT WILL[F8]TAKE [FB][29]YOU BACK TO[FD]ANY PLACE[FB][15] YOU [FB][28]HAVE[FF]TRAVELLED[FB][29] BEFORE.[FE][F8][FC]"
        },
        "7": {
          "text_offset": "0x000000",
          "pointer_offset": "0x000E",
          "block_address": "0x072B66",
          "logical_address": "0xAB66",
          "bytes": 350,
          "original": "YOUR[FB][28] PATH[FB][29] LIES[FF]THROUGH[FB][28] A TINY[FE][FB][29]CAVERN UP [FB][28]AHEAD,[F8][FB][29]BUT, [FB][28]IN ORDER TO[FD]ENTER[FB][28] IT [FB][29]YOU HAVE[FF]TO SHRINK[FB][29] IN SIZE![FB][28][FE]THERE'S A[FB][28] SHRINKING[FB][29][F8][FB][28]POTION IN THE[FD]CASTLE[FB][29] RUINS.[FF][FB][28]NOW THAT[FB][29] THE FIRE[FE][FB][28]IN MY CASTLE HAS[FB][29][F8][FB][28]WEAKENED, THE WATER[FD]IN [FB][28]THE [FB][29]LAKE HAS[FF]RISEN[FB][28]. [FB][29]YOU SHOULD[FE]BE ABLE[FB][29] TO FIND A[F8]PASSAGE[FB][28] TO THE[FD]RUINS [FB][29]FROM THE[FF][FB][28]LAKE.[FE][F8][FC]"
        },
        "8": {
          "text_offset": "0x000000",
          "pointer_offset": "0x0010",
          "block_address": "0x072CA7",
          "logical_address": "0xACA7",
          "bytes": 332,
          "original": "[FB][18][FB][2A]GAWRSH! [FB][28]I COULDN'T[FF]GET AWAY FROM[FB][2A] MY[FB][28][FE]OWN TOYS! THANK YOU[F8]FOR [FB][2A][FB][28]RELEASING ME,[FD][FB][18]MICKEY[FB][2A]. YOU[FB][28]'LL SEE[FF]A CLIFF UP AHEAD.[FB][2A][FE]IF[FB][28] YOU WANNA CLIMB[FB][2A][F8]IT[FB][28], YOU'LL NEED THE[FD][FB][18]ROPE[FB][2A] [FB][28]IN THE PALACE[FF]RUINS. [FB][28]JUST TO SAY[FB][2A][FE][FB][19][FB][1A]THANKS, I'LL SHOOT[F8][FB][2A]OFF [FB][28]THIS HERE[FD][FB][18]TOY [FB][28]CANNON TO[FF]DESTROY[FB][2A] THE[FE]BOULDERS[FB][28] BLOCKIN'[F8][FB][2A]YOUR PATH![FC]"
        },
        "9": {
          "text_offset": "0x000000",
          "pointer_offset": "0x0012",
          "block_address": "0x072DEB",
          "logical_address": "0xADEB",
          "bytes": 114,
          "original": "[FB][18]YOU[FB][28]'LL SEE [FB][2A]A CLIFF[FF]UP AHEAD.[FB][28] IF YOU[FE]WANNA CLIMB[FB][2A] IT,[F8]YOU'LL[FB][28] NEED THE[FD][FB][18]ROPE IN[FB][2A] THE PALACE[FB][28][FF]RUINS.[FE][F8][FC]"
        }
      }
